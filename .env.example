# Copy to .env and replace every change-me value before deploying.
# Keep .env private; it is intentionally ignored by Git.
JWT_SECRET=change-me-use-at-least-32-random-characters
MYSQL_PASSWORD=change-me-database-user-password
MYSQL_ROOT_PASSWORD=change-me-database-root-password
TURN_SECRET=change-me-turn-shared-secret

# Optional Android push credentials.
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
