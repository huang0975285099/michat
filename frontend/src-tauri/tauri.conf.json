{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yunmi",
  "version": "../package.json",
  "identifier": "com.yzs88.e2eechat",
  "build": {
    "beforeDevCommand": "pnpm quasar dev",
    "devUrl": "http://localhost:9999",
    "beforeBuildCommand": "pnpm quasar build -m spa",
    "frontendDist": "../dist/spa"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yunmi",
        "width": 375,
        "height": 667,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
